{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "direborn-all-in-one-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API requests go to the Worker; everything else is the React app.
    "run_worker_first": ["/api/*"]
  },
  // Shared schedule database. On the first deploy Wrangler creates it
  // automatically and attaches it to the Worker; later deploys reuse it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "direborn"
    }
  ],
  "observability": { "enabled": true }
}
